# PromoFinder local settings. run.sh / run.bat copy this to .env on first launch.
# .env stays on this computer: it is git-ignored and never written to any output.

# ---- Optional: LLM second opinion on the shortlist -------------------------------------------
# Pick ONE provider and add its key. Free tiers that work:
#   gemini     -> key from https://aistudio.google.com/apikey           (GEMINI_API_KEY)
#   groq       -> key from https://console.groq.com/keys                 (GROQ_API_KEY)
#   openrouter -> key from https://openrouter.ai/keys, ":free" models    (OPENROUTER_API_KEY)
#   ollama     -> no key; install https://ollama.com and `ollama pull llama3.1`
# Paid: anthropic (ANTHROPIC_API_KEY), openai (OPENAI_API_KEY).
PROMOFINDER_LLM_PROVIDER=
# GEMINI_API_KEY=
# GROQ_API_KEY=
# OPENROUTER_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# PROMOFINDER_LLM_MODEL=           # optional: override the provider's default model
# PROMOFINDER_LLM_BASE_URL=        # only for provider openai_compatible (e.g. a vLLM server)

# ---- Optional: neural embeddings for scene search ----------------------------------------------
# Search works offline without this. To blend in a small embedding model:
#   .venv/bin/pip install model2vec      (Windows: .venv\Scripts\pip install model2vec)
# PROMOFINDER_EMBED_MODEL=minishlab/potion-base-8M

# ---- Server ------------------------------------------------------------------------------------
# PORT=7860
# HOST=127.0.0.1                   # 0.0.0.0 to let other computers on your network open it
